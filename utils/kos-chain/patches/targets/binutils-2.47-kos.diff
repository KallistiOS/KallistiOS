+  { DVP_MIPS_LINK_SUB, NULL, NULL },
+  { DVP_MIPS_LINK_REFUSE, dvp_mips_higher_addend, DVP_MIPS_WHY_PAIRING },
+  { DVP_MIPS_LINK_REFUSE, dvp_mips_highest_addend, DVP_MIPS_WHY_PAIRING },
