+  { DVP_MIPS_LINK_REFUSE, NULL, DVP_MIPS_WHY_GOT },
+  { DVP_MIPS_LINK_REFUSE, NULL, DVP_MIPS_WHY_FORM },
+  { DVP_MIPS_LINK_REFUSE, NULL, DVP_MIPS_WHY_GOT },
