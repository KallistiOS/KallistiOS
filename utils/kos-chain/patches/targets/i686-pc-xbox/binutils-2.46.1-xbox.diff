@@ -253,6 +253,7 @@
   i386-*-msdos*)			fmt=aout ;;
   i386-*-moss*)				fmt=elf ;;
   i386-*-pe)				fmt=coff em=pe ;;
+  i386-*-xbox*)			fmt=coff em=pe ;;
   i386-*-cygwin*)
    case ${cpu} in
      x86_64*)				fmt=coff em=pep ;;
